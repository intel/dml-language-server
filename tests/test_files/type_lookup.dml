saved packet_t last_packet; // @goto-def-decl[7]->packet_t_def @goto-type-def[16]->packet_t_def @goto-ref[16]->last_packet_use,last_packet_use_2

// @loc[8]=process_method_def
method process( // @goto-ref[8]->process_method_use
    // @loc[5]=packet_t_use_arg
    // @loc[14]=pkt_arg_def
    packet_t pkt, // @goto-ref[14]->pkt_arg_use_1,pkt_arg_use_2,pkt_arg_use_3,pkt_arg_use_4
    // @loc[5]=register_addr_t_use_arg
    // @loc[21]=base_addr_arg_def
    register_addr_t base_addr // @goto-ref[21]->base_addr_arg_use_1,base_addr_arg_use_2
) {
    // @loc[5]=current_addr_use_1
    // @loc[20]=base_addr_arg_use_1
    current_addr = base_addr; // @goto-def-decl[5]->current_addr_def @goto-def-decl[20]->base_addr_arg_def

    // @loc[20]=pkt_arg_use_1
    // @loc[24]=packet_addr_field_use
    // @loc[31]=base_addr_arg_use_2
    // @loc[5]=current_addr_use_2
    current_addr = pkt.addr + base_addr; // @goto-def-decl[5]->current_addr_def @goto-def-decl[20]->pkt_arg_def @goto-def-decl[24]->packet_addr_field_def @goto-def-decl[31]->base_addr_arg_def

    // @loc[34]=pkt_arg_use_2
    // @loc[38]=packet_addr_field_use_2
    // @loc[44]=pkt_arg_use_3
    // @loc[48]=packet_size_field_use
    log info: "addr=%d size=%d", pkt.addr, pkt.size; // @goto-def-decl[34]->pkt_arg_def @goto-def-decl[38]->packet_addr_field_def @goto-def-decl[44]->pkt_arg_def @goto-def-decl[48]->packet_size_field_def

