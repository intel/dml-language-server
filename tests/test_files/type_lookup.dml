}

method kickoff() {
    // @loc[5]=process_method_use
    // @loc[13]=last_packet_use_2
    process(last_packet, 0); // @goto-def-decl[5]->process_method_def @goto-def-decl[13]->last_packet_def

    // @loc[21]=T_use_1
    // @loc[23]=template_t_foo_field_use
