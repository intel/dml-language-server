template funcptr_vararg_mismatch_tmpl is funcptr_equivalence_base_tmpl {
    // @error[35]="Mismatching argument type in method override"
    method funcptr_arg_target(int cb(int, float, ...)) {
    }
}

template funcptr_match_tmpl is funcptr_equivalence_base_tmpl {
    method funcptr_arg_target(int cb(int, float)) {
    }
}

// --- Nominal identity of independently-declared struct typedefs with identical shape ---
typedef struct { int x; } struct_shape_a_t;
typedef struct { int x; } struct_shape_b_t;

template struct_identity_base_tmpl {
    // @related[52]of[145]="Corresponding argument declared here"
    method struct_identity_target(struct_shape_a_t a) default {
    }
}

template struct_identity_mismatch_tmpl is struct_identity_base_tmpl {
    // @error[52]="Mismatching argument type in method override"
    method struct_identity_target(struct_shape_b_t a) {
    }
}

template struct_identity_match_tmpl is struct_identity_base_tmpl {
    method struct_identity_target(struct_shape_a_t a) {
    }
}

