dml 1.4;
device type_structs;

typedef bool bool_alias; // @loc[14]=bool_alias_def
typedef int int_alias; // @loc[13]=int_alias_def

typedef struct {
    int value;
} diagnostic_inner_t;

extern typedef struct {
    transaction_t *prev;
    struct { } *_cache;
// @loc[3]=transaction_t_def
} transaction_t;

typedef struct {
