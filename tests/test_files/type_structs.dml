        // @diag-error: bad_pointer_field | related->bad_pointer_field_decl: declared as 'int_alias' here
        // @goto-def-decl[25]->bad_pointer_field_decl @goto-type-def[25]->int_alias_def
        local int_alias bad_pointer_field = value.pointer; // @loc[25]=bad_pointer_field_decl
        // @diag-error: bad_array_field | related->bad_array_field_decl: declared as 'bool_alias' here
        // @goto-def-decl[26]->bad_array_field_decl @goto-type-def[26]->bool_alias_def
