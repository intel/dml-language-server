    method recursive_struct_pointer(transaction_t *modified_txn) {
        // @loc[30]=prev_modified_decl @goto-def-decl[30]->prev_modified_decl @goto-type-def[30]->transaction_t_def
        local transaction_t *prev_modified = modified_txn->prev;
