        local int_alias scalar_field = value.value;
        // @loc[26]=pointer_field_decl @goto-def-decl[26]->pointer_field_decl @goto-type-def[26]->int_alias_def
        local int_alias *pointer_field = value.pointer;
        // @loc[26]=array_field_decl @goto-def-decl[26]->array_field_decl @goto-type-def[26]->int_alias_def
        local int_alias *array_field = value.array;
        // @loc[25]=array_element_decl @goto-def-decl[25]->array_element_decl @goto-type-def[25]->int_alias_def
        local int_alias array_element = value.array[0];
        // @loc[25]=nested_field_decl @goto-def-decl[25]->nested_field_decl @goto-type-def[25]->int_alias_def
        local int_alias nested_field = value.nested.value;
        // @loc[25]=indirect_field_decl @goto-def-decl[25]->indirect_field_decl @goto-type-def[25]->int_alias_def
        local int_alias indirect_field = pointer->value;

        // @diag-error: bad_scalar_field | related->bad_scalar_field_decl: declared as 'bool_alias' here
        // @goto-def-decl[26]->bad_scalar_field_decl @goto-type-def[26]->bool_alias_def
