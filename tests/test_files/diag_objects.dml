// Loggroups in mutually exclusive top-level '#if' branches do not collide
#if (true) {
    loggroup lg_cond; // @loc[14]=lg_cond_true
} #else {
    loggroup lg_cond; // @loc[14]=lg_cond_false
}
#if (true) {
    // @diag-error: Duplicate loggroup name; 'lg' | related->lg_first: Previously defined here
    loggroup lg;
}

method log_cond() {
    log info, 1, lg_cond: "x"; // @goto-def[18]->lg_cond_true,lg_cond_false
}

method m1() { }
method m2() { }

export m1 as "m_dup"; // @loc[14]=m_dup_first
// @diag-error: Duplicate export name; 'm_dup' | related->m_dup_first: Previously defined here
export m2 as "m_dup";

// Plain 'if' does not exclude an error statement, only '#if' does
method errors() {
    if (false) {
        // @diag-error: forced compilation error in source code
        error;
    }
    if (true) {
    } else {
        // @diag-error: forced compilation error in source code
        error;
    }
}

// '#if' branches are only checked when the condition is known
param unknown_condition default true;
method hashif_errors() {
    #if (true) {
        // @diag-error: taken branch
        error "taken branch";
    } #else {
        error "untaken else";
    }
    #if (!dml_1_4) {
        error "untaken if";
    } #else {
        // @diag-error: taken else
        error "taken else";
    }
    #if (unknown_condition) {
        error "unknown condition";
    }
    switch (1) {
    case 1:
        #if (true && !false) {
            // @diag-error: taken switch branch
            error "taken switch branch";
        } #else {
            error "untaken switch branch";
        }
    }
}

// Overridden bodies are dead unless reached through 'default()'
template must_override {
    method dead() default {
        error "Must be overridden";
    }
    method reached() default {
        // @diag-error: reached through default
        error "reached through default";
    }
    method dead_behind_reached() default {
        error "behind an override that is itself dead";
    }
    method reached_qualified() default {
        // @diag-error: reached through a template-qualified call
        error "reached through a template-qualified call";
    }
    method default_in_dead_branch() default {
        error "default() only in an excluded branch";
    }
    method default_in_unknown_branch() default {
        // @diag-error: default() in a branch that may be taken
        error "default() in a branch that may be taken";
    }
}
template middle is must_override {
    method dead_behind_reached() default {
        default();
    }
}
group overrides is middle {
    method dead() {}
    method reached() {
        default();
    }
    method dead_behind_reached() {}
    method reached_qualified() {
        templates.must_override.reached_qualified();
    }
    method default_in_dead_branch() {
        #if (false) {
            default();
        }
    }
    method default_in_unknown_branch() {
        #if (unknown_condition) {
            default();
        }
    }
}

// @diag-error: unconditional error object
error "unconditional error object";

#if (false) {
    error "guarded";
}
