// A method cannot override a parameter, and a parameter cannot override
// anything
template abstract_param {
    param p0 : int; // @loc[11]=abstract_p0
}

template shared_method_override is abstract_param {
    // @diag-error: Name collision on 'p0' | related->abstract_p0: Previously defined here
    shared method p0();
}

template method_override is abstract_param {
    // @diag-error: Name collision in declaration on 'p0' | related->abstract_p0: also declared here, related->po_p0: also declared here
    method p0() {}
}

